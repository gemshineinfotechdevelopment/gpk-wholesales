# Backend API base URL for Frontend build (Vite environment variable)
# Local Development:
VITE_API_URL=http://localhost:5032/api

# For Production build with Nginx reverse proxy (same domain /api):
# VITE_API_URL=/api

# For separate backend domain (e.g. gpk-billing.gemshine.tech):
# VITE_API_URL=https://gpk-billing.gemshine.tech/api
