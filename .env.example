# Backend API base URL for Frontend build (Vite environment variable)
# Local Development:
VITE_API_URL=http://localhost:5004/api

# For Production build with Nginx reverse proxy (same domain /api):
# VITE_API_URL=/api

# For separate backend domain (e.g. api.yourdomain.com):
# VITE_API_URL=https://api.yourdomain.com/api
