# Backend Server Port
PORT=5004

# Environment Mode (development / production)
NODE_ENV=development

# Database Connection
# For MongoDB Atlas (Cloud Database):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.zr2dveb.mongodb.net/gpk_wholesales?retryWrites=true&w=majority

# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/gpk_wholesales

# Frontend Client URL for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudinary Storage Configuration for PDF / File Uploads
# Get these from your Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
