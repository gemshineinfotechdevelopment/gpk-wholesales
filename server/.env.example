# Backend Server Port
PORT=5032

# Environment Mode (development / production)
NODE_ENV=production

# Database Connection
# For Local VPS MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/gpk_billing

# For MongoDB Atlas (Cloud Database):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.zr2dveb.mongodb.net/gpk_billing?retryWrites=true&w=majority

# Frontend Client URL for CORS (comma-separated for multiple origins)
CORS_ORIGIN=https://gpk-billing.gemshine.tech,http://localhost:5173,http://localhost:3000

# Cloudinary Storage Configuration for PDF / File Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
